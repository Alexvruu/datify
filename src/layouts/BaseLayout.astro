---
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-sans-condensed/600.css'
import '@fontsource/ibm-plex-sans-condensed/700.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'
import { SITE_URL, GTM_ID, CALENDLY_URL, CONTACT_EMAIL, LINKEDIN_URL } from '../../site.config.mjs'
import { PLAN_OFFRES } from '../data/offres-detail'

interface Props {
  title: string
  description: string
  image?: string
  type?: string
  /** true pour les landings de prospection et leurs variantes A/B : hors index. */
  noindex?: boolean
  /** true pour une landing de trafic froid : navigation et pied de page réduits
   *  au minimum, pour ne laisser qu'une seule sortie possible, le rendez-vous. */
  landing?: boolean
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  landing = false
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, SITE_URL)
const ogImage = new URL(image, SITE_URL).toString()
const fullTitle = `${title} | Datify`
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Pose .js avant le premier rendu : sans JS, rien n'est masque. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Consent Mode v2 : refus par défaut, AVANT tout chargement GTM -->
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag(){dataLayer.push(arguments)}
      window.gtag = gtag

      var DATIFY_CONSENT_KEY = 'datify_consent_v1'
      var stored = null
      try { stored = JSON.parse(localStorage.getItem(DATIFY_CONSENT_KEY) || 'null') } catch (e) {}

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      })

      if (stored && stored.analytics) {
        gtag('consent', 'update', {
          ad_storage: stored.ads ? 'granted' : 'denied',
          ad_user_data: stored.ads ? 'granted' : 'denied',
          ad_personalization: stored.ads ? 'granted' : 'denied',
          analytics_storage: 'granted'
        })
      }
    </script>

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',GTM_ID);</script>
    <!-- End Google Tag Manager -->

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alexandre Gire",
      "url": SITE_URL,
      "jobTitle": "Analytics Engineer & Media Buyer",
      "worksFor": { "@type": "Organization", "name": "Datify" },
      "sameAs": [LINKEDIN_URL]
    })} />

  </head>

  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- NAVBAR -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50">
      <nav class="container flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="/" class="logo shrink-0 text-[1.2rem] font-semibold tracking-tight" aria-label="Datify, accueil">Dati<span>fy</span></a>

        <!-- Nav links (desktop) — absents du DOM sur les landings de prospection -->
        {!landing && (
          <div class="hidden md:flex items-center gap-10">
            <a
              href="/offres"
              id="offres-toggle"
              class="nav-link text-sm font-medium inline-flex items-center gap-1.5"
              aria-expanded="false"
              aria-controls="offres-panneau"
              aria-current={currentPath.startsWith('/offres') ? 'page' : undefined}
            >
              Offres
              <span id="offres-fleche" class="text-[10px] transition-transform duration-200" aria-hidden="true">▾</span>
            </a>
            {[
              { href: '/blog', label: 'Blog' },
              { href: '/contact', label: 'Contact' },
            ].map(({ href, label }) => (
              <a
                href={href}
                class="nav-link text-sm font-medium"
                aria-current={currentPath.startsWith(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))}
          </div>
        )}

        <!-- CTA + mobile toggle -->
        <div class="flex items-center gap-4">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="rdv"
            data-cta-loc="header"
            class={`${landing ? 'inline-flex' : 'hidden md:inline-flex'} btn-primary text-sm py-2.5 px-5`}
          >
            Diagnostic gratuit (30 min)
          </a>
          <!-- Mobile menu button -->
          {!landing && (
            <button id="menu-toggle" class="md:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-lg" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
              <span class="menu-bar w-5 h-0.5 rounded-full transition-transform duration-300"></span>
              <span class="menu-bar w-5 h-0.5 rounded-full transition-transform duration-300"></span>
            </button>
          )}
        </div>

      </nav>

      <!-- Panneau des offres (desktop) — quatre univers, comme quatre portes d'entrée -->
      {!landing && (
        <div id="offres-panneau" class="hidden md:block absolute left-0 right-0 top-[72px] bg-white border-t border-line shadow-[0_12px_32px_rgba(11,27,43,0.10)]" hidden>
          <div class="container py-8">
            <div class="grid lg:grid-cols-[minmax(0,3fr)_minmax(0,1fr)] gap-8">
              <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
                {PLAN_OFFRES.map((p, i) => (
                  <li>
                    <a href={`/offres/${p.slug}`} class="group block h-full rounded-md border border-line bg-paper p-5 hover:border-signal hover:bg-signal-soft transition-colors">
                      <span class="font-mono text-xs text-signal">{String(i + 1).padStart(2, '0')}</span>
                      <span class="block text-[15px] font-semibold text-ink mt-2 leading-snug">{p.nom}</span>
                      <span class="block text-sm text-body mt-1.5 leading-snug">{p.accroche}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <div class="rounded-md border border-line p-5 flex flex-col justify-between gap-4">
                <div>
                  <p class="text-[15px] font-semibold text-ink leading-snug">Vous ne savez pas laquelle ?</p>
                  <p class="text-sm text-body mt-1.5 leading-snug">30 minutes, votre site ouvert en direct, et je vous dis ce qui se justifie chez vous.</p>
                </div>
                <div class="flex flex-col gap-2">
                  <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-cta="rdv" data-cta-loc="menu-offres" class="btn-primary text-sm py-2.5 px-5 w-fit">Diagnostic gratuit</a>
                  <a href="/offres" class="text-sm font-medium text-signal hover:underline w-fit">Toutes les offres et les prix →</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Mobile menu — absent sur les landings -->
      {!landing && (
        <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-line">
          <div class="container py-6 flex flex-col gap-5">
            <div>
              <a href="/offres" class="text-base font-medium text-body hover:text-ink">Offres</a>
              <ul class="mt-3 pl-4 border-l border-line space-y-2.5">
                {PLAN_OFFRES.map((p) => (
                  <li><a href={`/offres/${p.slug}`} class="block text-sm text-body hover:text-ink">{p.nom}</a></li>
                ))}
              </ul>
            </div>
            <a href="/blog" class="text-base font-medium text-body hover:text-ink">Blog</a>
            <a href="/contact" class="text-base font-medium text-body hover:text-ink">Contact</a>
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-cta="rdv"
              data-cta-loc="menu-mobile"
              class="btn-primary w-fit mt-2"
            >Réserver un appel →</a>
          </div>
        </div>
      )}
    </header>

    <main class="pt-[72px]">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class={`nuit text-white ${landing ? 'pt-10' : 'pt-20'} pb-10 mt-0`}>
      <div class="container">
        <!-- Top — absent sur les landings : chaque lien y est une sortie -->
        {!landing && (
        <div class="grid md:grid-cols-3 gap-12 pb-16 border-b border-white/10">
          <!-- Brand -->
          <div>
            <p class="text-xl font-semibold tracking-tight mb-3 text-white">Dati<span class="text-[#7C75FF]">fy</span></p>
            <p class="text-sm text-white/50 leading-relaxed max-w-xs">
              Tracking server-side et data Google Cloud pour les e-commerçants qui investissent en Meta et Google Ads.
            </p>
          </div>
          <!-- Nav -->
          <div>
            <p class="label text-white/30 mb-5">Navigation</p>
            <div class="flex flex-col gap-3">
              {[
                { href: '/', label: 'Accueil' },
                { href: '/offres', label: 'Offres' },
                { href: '/blog', label: 'Blog' },
                { href: '/contact', label: 'Contact' },
              ].map(({ href, label }) => (
                <a href={href} class="text-sm text-white/60 hover:text-white transition-colors w-fit">{label}</a>
              ))}
            </div>
          </div>
          <!-- Contact -->
          <div>
            <p class="label text-white/30 mb-5">Contact</p>
            <div class="flex flex-col gap-3">
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-sm text-white/60 hover:text-white transition-colors w-fit">
                {CONTACT_EMAIL}
              </a>
              <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-white/60 hover:text-white transition-colors w-fit">
                LinkedIn
              </a>
              <span class="inline-flex items-center gap-2 text-sm text-signal font-medium mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-signal animate-pulse"></span>
                Disponible pour missions
              </span>
            </div>
          </div>
        </div>
        )}

        <!-- Bottom -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pt-8">
          <p class="text-xs text-white/30">
            © {new Date().getFullYear()} Datify — Alexandre Gire
          </p>
          <div class="flex gap-6">
            <a href="/mentions-legales" class="text-xs text-white/30 hover:text-white/60 transition-colors">Mentions légales</a>
            <button type="button" id="consent-reopen" class="text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer">Gérer les cookies</button>
            {!landing && <a href="/blog" class="text-xs text-white/30 hover:text-white/60 transition-colors">Blog</a>}
          </div>
        </div>
      </div>
    </footer>

    <!-- BANNIÈRE DE CONSENTEMENT -->
    <div
      id="consent-banner"
      hidden
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-title"
      class="fixed bottom-0 left-0 right-0 z-[100] bg-white border-t border-line shadow-[0_-4px_24px_rgba(10,37,64,0.08)]"
    >
      <div class="container py-6 flex flex-col lg:flex-row lg:items-center gap-5">
        <div class="flex-1">
          <p id="consent-title" class="text-sm font-semibold text-ink mb-1.5">Cookies et mesure d'audience</p>
          <p class="text-sm text-body leading-relaxed max-w-2xl">
            J'utilise des cookies de mesure d'audience pour comprendre comment le site est utilisé.
            Rien n'est déposé sans votre accord. Vous pouvez changer d'avis à tout moment depuis le pied de page.
            <a href="/mentions-legales" class="text-signal hover:underline">En savoir plus</a>.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <button type="button" id="consent-refuse" class="btn-ghost text-sm py-2.5 px-5">Refuser</button>
          <button type="button" id="consent-accept" class="btn-primary text-sm py-2.5 px-5">Accepter</button>
        </div>
      </div>
    </div>

    <script>
      const CONSENT_KEY = 'datify_consent_v1'
      const banner = document.getElementById('consent-banner')

      const hasChoice = () => {
        try { return localStorage.getItem(CONSENT_KEY) !== null } catch (e) { return false }
      }

      const showBanner = () => { if (banner) banner.hidden = false }
      const hideBanner = () => { if (banner) banner.hidden = true }

      const record = (analytics: boolean) => {
        const choice = { analytics, ads: false, ts: Date.now() }
        try { localStorage.setItem(CONSENT_KEY, JSON.stringify(choice)) } catch (e) {}

        const gtag = (window as any).gtag
        if (typeof gtag === 'function') {
          gtag('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: analytics ? 'granted' : 'denied'
          })
        }
        ;(window as any).dataLayer?.push({
          event: 'consent_choice',
          consent_analytics: analytics ? 'granted' : 'denied'
        })
        hideBanner()
      }

      if (!hasChoice()) showBanner()

      document.getElementById('consent-accept')?.addEventListener('click', () => record(true))
      document.getElementById('consent-refuse')?.addEventListener('click', () => record(false))
      document.getElementById('consent-reopen')?.addEventListener('click', () => showBanner())
    </script>

    <!-- ÉVÉNEMENTS DE CONVERSION -->
    <script>
      // Tout élément portant data-cta pousse un événement nommé dans le dataLayer.
      document.querySelectorAll('[data-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const cta = el.getAttribute('data-cta')
          ;(window as any).dataLayer?.push({
            event: cta === 'rdv' ? 'rdv_click' : 'cta_click',
            cta_name: cta,
            cta_location: el.getAttribute('data-cta-loc') || 'inconnu',
            page_path: window.location.pathname
          })
        })
      })
    </script>

    <!-- Navbar scroll behavior -->
    <script>
      // Header : transparent tant qu'il survole le hero sombre, blanc dès qu'il passe
      // sur du contenu clair. Un seul IntersectionObserver, rien de calculé au scroll.
      const header = document.getElementById('site-header')
      const hero = document.querySelector('main > section.nuit:first-of-type')
      const HEADER_H = 72
      let heroObserver: IntersectionObserver | null = null
      const watchHero = () => {
        heroObserver?.disconnect()
        if (!hero || !header) return
        heroObserver = new IntersectionObserver(
          ([e]) => header.classList.toggle('is-light', !e.isIntersecting),
          { rootMargin: `0px 0px -${Math.max(window.innerHeight - HEADER_H, 0)}px 0px` }
        )
        heroObserver.observe(hero)
      }
      watchHero()
      window.addEventListener('resize', watchHero, { passive: true })

      // Panneau des offres : ouverture au clic, survol sur souris, fermeture par Échap ou clic extérieur.
      const offresToggle = document.getElementById('offres-toggle')
      const offresPanneau = document.getElementById('offres-panneau')
      const offresFleche = document.getElementById('offres-fleche')
      let offresOuvert = false
      let fermeture: ReturnType<typeof setTimeout> | null = null
      // Échap rend le focus au lien : sans ce verrou, le focus rouvrirait le panneau.
      let verrou = false

      const setOffres = (ouvert: boolean) => {
        offresOuvert = ouvert
        if (offresPanneau) offresPanneau.hidden = !ouvert
        offresToggle?.setAttribute('aria-expanded', String(ouvert))
        offresFleche?.classList.toggle('rotate-180', ouvert)
        header?.classList.toggle('menu-open', ouvert)
      }

      // Souris : le panneau s'ouvre au survol, le clic sur « Offres » va à la page.
      // Sans survol (tactile) : le clic ouvre le panneau au lieu de naviguer.
      const avecSurvol = window.matchMedia('(hover: hover) and (pointer: fine)').matches
      if (avecSurvol) {
        const ouvrir = () => { if (verrou) return; if (fermeture) clearTimeout(fermeture); setOffres(true) }
        const fermerPlusTard = () => { if (fermeture) clearTimeout(fermeture); fermeture = setTimeout(() => setOffres(false), 180) }
        offresToggle?.addEventListener('mouseenter', ouvrir)
        offresToggle?.addEventListener('mouseleave', fermerPlusTard)
        offresToggle?.addEventListener('focus', ouvrir)
        offresPanneau?.addEventListener('mouseenter', ouvrir)
        offresPanneau?.addEventListener('mouseleave', fermerPlusTard)
      } else {
        offresToggle?.addEventListener('click', (e) => { e.preventDefault(); setOffres(!offresOuvert) })
      }

      // Le panneau se ferme dès que le focus en sort (navigation au clavier).
      document.addEventListener('focusin', (e) => {
        if (!offresOuvert) return
        const cible = e.target as Node
        if (!offresPanneau?.contains(cible) && !offresToggle?.contains(cible)) setOffres(false)
      })

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !offresOuvert) return
        verrou = true
        setOffres(false)
        offresToggle?.focus()
        setTimeout(() => { verrou = false }, 400)
      })
      document.addEventListener('click', (e) => {
        if (!offresOuvert) return
        const cible = e.target as Node
        if (!offresPanneau?.contains(cible) && !offresToggle?.contains(cible)) setOffres(false)
      })

      // Mobile menu
      const toggle = document.getElementById('menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      const bars = document.querySelectorAll('.menu-bar')
      let open = false

      toggle?.addEventListener('click', () => {
        open = !open
        mobileMenu?.classList.toggle('hidden', !open)
        header?.classList.toggle('menu-open', open)
        toggle.setAttribute('aria-expanded', String(open))
        bars[0]?.classList.toggle('rotate-45', open)
        bars[0]?.classList.toggle('translate-y-[4px]', open)
        bars[1]?.classList.toggle('-rotate-45', open)
        bars[1]?.classList.toggle('-translate-y-[4px]', open)
      })

      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view')
              observer.unobserve(e.target)
            }
          })
        },
        { threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
      )
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
    </script>


  </body>
</html>
