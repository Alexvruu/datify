---
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-sans-condensed/600.css'
import '@fontsource/ibm-plex-sans-condensed/700.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/global.css'
import { SITE_URL, GTM_ID, CALENDLY_URL, CONTACT_EMAIL, LINKEDIN_URL } from '../../site.config.mjs'
import { UNIVERS, offresParUnivers } from '../data/offres-detail'

interface Props {
  title: string
  description: string
  image?: string
  type?: string
  /** true pour les landings de prospection et leurs variantes A/B : hors index. */
  noindex?: boolean
  /** true pour une landing de trafic froid : navigation et pied de page réduits
   *  au minimum, pour ne laisser qu'une seule sortie possible, le rendez-vous. */
  landing?: boolean
}

const {
  title,
  description,
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  landing = false
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, SITE_URL)
const ogImage = new URL(image, SITE_URL).toString()
const fullTitle = `${title} | Datify`
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <!-- Pose .js avant le premier rendu : sans JS, rien n'est masque. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Consent Mode v2 : refus par défaut, AVANT tout chargement GTM -->
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag(){dataLayer.push(arguments)}
      window.gtag = gtag

      var DATIFY_CONSENT_KEY = 'datify_consent_v1'
      var stored = null
      try { stored = JSON.parse(localStorage.getItem(DATIFY_CONSENT_KEY) || 'null') } catch (e) {}

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      })

      if (stored && stored.analytics) {
        gtag('consent', 'update', {
          ad_storage: stored.ads ? 'granted' : 'denied',
          ad_user_data: stored.ads ? 'granted' : 'denied',
          ad_personalization: stored.ads ? 'granted' : 'denied',
          analytics_storage: 'granted'
        })
      }
    </script>

    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',GTM_ID);</script>
    <!-- End Google Tag Manager -->

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alexandre Gire",
      "url": SITE_URL,
      "jobTitle": "Analytics Engineer & Media Buyer",
      "worksFor": { "@type": "Organization", "name": "Datify" },
      "sameAs": [LINKEDIN_URL]
    })} />

  </head>

  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <a href="#contenu" class="skip-link">Aller au contenu</a>

    <!-- NAVBAR -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50">
      <nav class="container flex items-center justify-between h-[72px]">

        <!-- Logo -->
        <a href="/" class="logo shrink-0 text-[1.2rem] font-semibold tracking-tight" aria-label="Datify, accueil">Dati<span>fy</span></a>

        <!-- Nav links (desktop) : absents du DOM sur les landings de prospection -->
        {!landing && (
          <div class="hidden md:flex items-center gap-8">
            {UNIVERS.map((u) => (
              <a
                href="/offres"
                id={`toggle-${u.cle}`}
                data-univers={u.cle}
                class="nav-link text-sm font-medium inline-flex items-center gap-1.5"
                aria-expanded="false"
                aria-controls={`panneau-${u.cle}`}
                aria-current={offresParUnivers(u.cle).some((p) => currentPath.startsWith(`/offres/${p.slug}`)) ? 'page' : undefined}
              >
                {u.court}
                <span class="fleche text-[10px] transition-transform duration-200" aria-hidden="true">▾</span>
              </a>
            ))}
            {[
              { href: '/ressources', label: 'Ressources' },
              { href: '/blog', label: 'Blog' },
              { href: '/contact', label: 'Contact' },
            ].map(({ href, label }) => (
              <a href={href} class="nav-link text-sm font-medium" aria-current={currentPath.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            ))}
          </div>
        )}

        <!-- CTA + mobile toggle -->
        <div class="flex items-center gap-4">
          <a
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="rdv"
            data-cta-loc="header"
            class={`${landing ? 'inline-flex' : 'hidden md:inline-flex'} btn-primary text-sm py-2.5 px-5`}
          >
            Diagnostic gratuit (30 min)
          </a>
          <!-- Mobile menu button -->
          {!landing && (
            <button id="menu-toggle" class="md:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-lg" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
              <span class="menu-bar w-5 h-0.5 rounded-full transition-transform duration-300"></span>
              <span class="menu-bar w-5 h-0.5 rounded-full transition-transform duration-300"></span>
            </button>
          )}
        </div>

      </nav>

      <!-- Un panneau par univers, ouvert au survol de son entrée de menu -->
      {!landing && UNIVERS.map((u) => (
        <div id={`panneau-${u.cle}`} class="panneau-univers hidden md:block absolute left-0 right-0 top-[72px] bg-white border-t border-line shadow-[0_12px_32px_rgba(11,27,43,0.10)]" hidden>
          <div class="container py-7">
            <div class="grid lg:grid-cols-[minmax(0,1fr)_260px] gap-8">
              <div>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-4">
                  <p class="text-lg font-semibold text-ink">{u.nom}</p>
                  <p class="text-sm text-muted">{u.promesse}</p>
                </div>
                <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {offresParUnivers(u.cle).map((p, i) => (
                    <li>
                      <a href={`/offres/${p.slug}`} class="block h-full rounded-md border border-line bg-paper p-4 hover:border-signal hover:bg-signal-soft transition-colors">
                        <span class="font-mono text-xs text-signal">{String(i + 1).padStart(2, '0')}</span>
                        <span class="block text-[15px] font-semibold text-ink mt-1.5 leading-snug">{p.nom}</span>
                        <span class="block text-[13px] text-body mt-1 leading-snug">{p.accroche}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-md border border-line bg-paper p-5 flex flex-col gap-3 self-start">
                <p class="text-[15px] font-semibold text-ink leading-snug">Vous ne savez pas laquelle ?</p>
                <p class="text-sm text-body leading-snug">30 minutes, votre situation en direct, et je vous dis ce qui se justifie.</p>
                <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-cta="rdv" data-cta-loc={`menu-${u.cle}`} class="btn-primary text-sm py-2.5 px-5 w-fit">Diagnostic gratuit</a>
                <a href="/offres" class="text-sm font-medium text-signal hover:underline w-fit">Toutes les offres et les prix →</a>
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Mobile menu : absent sur les landings -->
      {!landing && (
        <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-line">
          <div class="container py-6 flex flex-col gap-5">
            <div>
              <a href="/offres" class="text-base font-medium text-body hover:text-ink">Offres</a>
              {UNIVERS.map((u) => (
                <div class="mt-3 pl-4 border-l border-line">
                  <p class="font-mono text-[11px] uppercase tracking-wider text-muted mb-2">{u.nom}</p>
                  <ul class="space-y-2.5 mb-3">
                    {offresParUnivers(u.cle).map((p) => (
                      <li><a href={`/offres/${p.slug}`} class="block text-sm text-body hover:text-ink">{p.nom}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <a href="/ressources" class="text-base font-medium text-body hover:text-ink">Ressources</a>
            <a href="/blog" class="text-base font-medium text-body hover:text-ink">Blog</a>
            <a href="/contact" class="text-base font-medium text-body hover:text-ink">Contact</a>
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-cta="rdv"
              data-cta-loc="menu-mobile"
              class="btn-primary w-fit mt-2"
            >Réserver un appel →</a>
          </div>
        </div>
      )}
    </header>

    <main id="contenu" class="pt-[72px]">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class={`nuit text-white ${landing ? 'pt-10' : 'pt-20'} pb-10 mt-0`}>
      <div class="container">
        <!-- Top : absent sur les landings, chaque lien y est une sortie -->
        {!landing && (
        <div class="grid md:grid-cols-3 gap-12 pb-16 border-b border-white/10">
          <!-- Brand -->
          <div>
            <p class="text-xl font-semibold tracking-tight mb-3 text-white">Dati<span class="text-[#7C75FF]">fy</span></p>
            <p class="text-sm text-white/50 leading-relaxed max-w-xs">
              Tracking server-side et data Google Cloud pour les e-commerçants qui investissent en Meta et Google Ads.
            </p>
          </div>
          <!-- Nav -->
          <div>
            <p class="label text-white/30 mb-5">Navigation</p>
            <div class="flex flex-col gap-3">
              {[
                { href: '/', label: 'Accueil' },
                { href: '/offres', label: 'Offres' },
                { href: '/blog', label: 'Blog' },
                { href: '/contact', label: 'Contact' },
              ].map(({ href, label }) => (
                <a href={href} class="text-sm text-white/60 hover:text-white transition-colors w-fit">{label}</a>
              ))}
            </div>
          </div>
          <!-- Contact -->
          <div>
            <p class="label text-white/30 mb-5">Contact</p>
            <div class="flex flex-col gap-3">
              <a href={`mailto:${CONTACT_EMAIL}`} class="text-sm text-white/60 hover:text-white transition-colors w-fit">
                {CONTACT_EMAIL}
              </a>
              <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-white/60 hover:text-white transition-colors w-fit">
                LinkedIn
              </a>
              <span class="inline-flex items-center gap-2 text-sm text-signal font-medium mt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-signal animate-pulse"></span>
                Disponible pour missions
              </span>
            </div>
          </div>
        </div>
        )}

        <!-- Bottom -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pt-8">
          <p class="text-xs text-white/30">
            © {new Date().getFullYear()} Datify · Alexandre Gire
          </p>
          <div class="flex gap-6">
            <a href="/mentions-legales" class="text-xs text-white/30 hover:text-white/60 transition-colors">Mentions légales</a>
            <button type="button" id="consent-reopen" class="text-xs text-white/30 hover:text-white/60 transition-colors cursor-pointer">Gérer les cookies</button>
            {!landing && <a href="/blog" class="text-xs text-white/30 hover:text-white/60 transition-colors">Blog</a>}
          </div>
        </div>
      </div>
    </footer>

    <!-- BANNIÈRE DE CONSENTEMENT -->
    <div
      id="consent-banner"
      hidden
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-title"
      class="fixed bottom-0 left-0 right-0 z-[100] bg-white border-t border-line shadow-[0_-4px_24px_rgba(10,37,64,0.08)]"
    >
      <div class="container py-6 flex flex-col lg:flex-row lg:items-center gap-5">
        <div class="flex-1">
          <p id="consent-title" class="text-sm font-semibold text-ink mb-1.5">Cookies et mesure d'audience</p>
          <p class="text-sm text-body leading-relaxed max-w-2xl">
            J'utilise des cookies de mesure d'audience pour comprendre comment le site est utilisé.
            Rien n'est déposé sans votre accord. Vous pouvez changer d'avis à tout moment depuis le pied de page.
            <a href="/mentions-legales" class="text-signal hover:underline">En savoir plus</a>.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <button type="button" id="consent-refuse" class="btn-ghost text-sm py-2.5 px-5">Refuser</button>
          <button type="button" id="consent-accept" class="btn-primary text-sm py-2.5 px-5">Accepter</button>
        </div>
      </div>
    </div>

    <script>
      const CONSENT_KEY = 'datify_consent_v1'
      const banner = document.getElementById('consent-banner')

      const hasChoice = () => {
        try { return localStorage.getItem(CONSENT_KEY) !== null } catch (e) { return false }
      }

      const showBanner = () => { if (banner) banner.hidden = false }
      const hideBanner = () => { if (banner) banner.hidden = true }

      const record = (analytics: boolean) => {
        const choice = { analytics, ads: false, ts: Date.now() }
        try { localStorage.setItem(CONSENT_KEY, JSON.stringify(choice)) } catch (e) {}

        const gtag = (window as any).gtag
        if (typeof gtag === 'function') {
          gtag('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: analytics ? 'granted' : 'denied'
          })
        }
        ;(window as any).dataLayer?.push({
          event: 'consent_choice',
          consent_analytics: analytics ? 'granted' : 'denied'
        })
        hideBanner()
      }

      if (!hasChoice()) showBanner()

      document.getElementById('consent-accept')?.addEventListener('click', () => record(true))
      document.getElementById('consent-refuse')?.addEventListener('click', () => record(false))
      document.getElementById('consent-reopen')?.addEventListener('click', () => showBanner())
    </script>

    <!-- ÉVÉNEMENTS DE CONVERSION -->
    <script define:vars={{ CALENDLY_URL }}>
      // Tout élément portant data-cta pousse un événement nommé dans le dataLayer.
      const push = (data) => { (window.dataLayer = window.dataLayer || []).push(data) }

      document.querySelectorAll('[data-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const cta = el.getAttribute('data-cta')
          push({
            event: cta === 'rdv' ? 'rdv_click' : 'cta_click',
            cta_name: cta,
            cta_location: el.getAttribute('data-cta-loc') || 'inconnu',
            page_path: window.location.pathname
          })
        })
      })

      // ── Prise de rendez-vous Calendly ───────────────────────────────────────
      // Le widget est chargé au premier clic, jamais avant : aucun script tiers
      // ni cookie Calendly sur une simple visite. Si le chargement échoue, le lien
      // s'ouvre normalement dans un onglet : on ne casse jamais la prise de rdv.
      let widgetPret = null
      let dernierEmplacement = 'inconnu'

      const chargerWidget = () => {
        if (widgetPret) return widgetPret
        widgetPret = new Promise((resolve, reject) => {
          const css = document.createElement('link')
          css.rel = 'stylesheet'
          css.href = 'https://assets.calendly.com/assets/external/widget.css'
          document.head.appendChild(css)

          const js = document.createElement('script')
          js.src = 'https://assets.calendly.com/assets/external/widget.js'
          js.async = true
          js.onload = resolve
          js.onerror = reject
          document.head.appendChild(js)

          setTimeout(reject, 4000)
        })
        return widgetPret
      }

      // La page d'origine voyage avec le rendez-vous : on la retrouve dans Calendly,
      // et elle sert de dimension dans GA4 pour savoir quelle page convertit.
      const urlAvecSource = () => {
        const u = new URL(CALENDLY_URL)
        u.searchParams.set('utm_source', 'site')
        u.searchParams.set('utm_medium', 'cta')
        u.searchParams.set('utm_campaign', window.location.pathname)
        u.searchParams.set('utm_content', dernierEmplacement)
        return u.toString()
      }

      document.querySelectorAll('[data-cta="rdv"]').forEach((el) => {
        el.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return
          dernierEmplacement = el.getAttribute('data-cta-loc') || 'inconnu'
          e.preventDefault()
          chargerWidget()
            .then(() => {
              if (!window.Calendly) throw new Error('widget indisponible')
              window.Calendly.initPopupWidget({ url: urlAvecSource() })
              push({ event: 'rdv_widget_ouvert', cta_location: dernierEmplacement, page_path: window.location.pathname })
            })
            .catch(() => { window.open(urlAvecSource(), '_blank', 'noopener') })
        })
      })

      // Étapes renvoyées par Calendly dans la popup. « rdv_confirme » est
      // l'événement à marquer comme conversion dans GA4 et Google Ads.
      const etapes = {
        'calendly.event_type_viewed': 'rdv_creneau_consulte',
        'calendly.date_and_time_selected': 'rdv_creneau_choisi',
        'calendly.event_scheduled': 'rdv_confirme'
      }
      window.addEventListener('message', (e) => {
        // Origine vérifiée strictement : « evilcalendly.com » ne doit pas passer.
        const origineOk = e.origin === 'https://calendly.com' || e.origin.endsWith('.calendly.com')
        if (typeof e.origin !== 'string' || !origineOk) return
        const nom = e.data && e.data.event
        if (!nom || !etapes[nom]) return
        push({
          event: etapes[nom],
          cta_location: dernierEmplacement,
          page_path: window.location.pathname,
          rdv_source: 'calendly'
        })
      })
    </script>

    <!-- Navbar scroll behavior -->
    <script>
      // Header : transparent tant qu'il survole le hero sombre, blanc dès qu'il passe
      // sur du contenu clair. Un seul IntersectionObserver, rien de calculé au scroll.
      const header = document.getElementById('site-header')
      const hero = document.querySelector('main > section.nuit:first-of-type')
      const HEADER_H = 72
      let heroObserver: IntersectionObserver | null = null
      const watchHero = () => {
        heroObserver?.disconnect()
        if (!hero || !header) return
        heroObserver = new IntersectionObserver(
          ([e]) => header.classList.toggle('is-light', !e.isIntersecting),
          { rootMargin: `0px 0px -${Math.max(window.innerHeight - HEADER_H, 0)}px 0px` }
        )
        heroObserver.observe(hero)
      }
      watchHero()
      window.addEventListener('resize', watchHero, { passive: true })

      // Panneaux d'univers : survol pour ouvrir sur souris, clic pour ouvrir sur tactile.
      // Un seul panneau ouvert à la fois ; le clic sur l'entrée mène à la page Offres.
      const toggles = Array.from(document.querySelectorAll('[data-univers]')) as HTMLElement[]
      const panneaux = new Map<string, HTMLElement>()
      toggles.forEach((t) => {
        const cle = t.getAttribute('data-univers') || ''
        const p = document.getElementById(`panneau-${cle}`)
        if (p) panneaux.set(cle, p)
      })
      let ouvert: string | null = null
      let fermeture: ReturnType<typeof setTimeout> | null = null
      let verrou = false

      const setPanneau = (cle: string | null) => {
        ouvert = cle
        panneaux.forEach((p, k) => { p.hidden = k !== cle })
        toggles.forEach((t) => {
          const k = t.getAttribute('data-univers')
          t.setAttribute('aria-expanded', String(k === cle))
          t.querySelector('.fleche')?.classList.toggle('rotate-180', k === cle)
        })
        header?.classList.toggle('menu-open', cle !== null)
      }

      const avecSurvol = window.matchMedia('(hover: hover) and (pointer: fine)').matches
      const fermerPlusTard = () => { if (fermeture) clearTimeout(fermeture); fermeture = setTimeout(() => setPanneau(null), 180) }

      toggles.forEach((t) => {
        const cle = t.getAttribute('data-univers') || ''
        const p = panneaux.get(cle)
        if (avecSurvol) {
          const ouvrir = () => { if (verrou) return; if (fermeture) clearTimeout(fermeture); setPanneau(cle) }
          t.addEventListener('mouseenter', ouvrir)
          t.addEventListener('mouseleave', fermerPlusTard)
          t.addEventListener('focus', ouvrir)
          p?.addEventListener('mouseenter', ouvrir)
          p?.addEventListener('mouseleave', fermerPlusTard)
        } else {
          t.addEventListener('click', (e) => { e.preventDefault(); setPanneau(ouvert === cle ? null : cle) })
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !ouvert) return
        const actif = ouvert
        verrou = true
        setPanneau(null)
        document.getElementById(`toggle-${actif}`)?.focus()
        setTimeout(() => { verrou = false }, 400)
      })
      document.addEventListener('click', (e) => {
        if (!ouvert) return
        const cible = e.target as Node
        const dedans = Array.from(panneaux.values()).some((p) => p.contains(cible)) || toggles.some((t) => t.contains(cible))
        if (!dedans) setPanneau(null)
      })
      document.addEventListener('focusin', (e) => {
        if (!ouvert) return
        const cible = e.target as Node
        const dedans = Array.from(panneaux.values()).some((p) => p.contains(cible)) || toggles.some((t) => t.contains(cible))
        if (!dedans) setPanneau(null)
      })

      // Mobile menu
      const toggle = document.getElementById('menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      const bars = document.querySelectorAll('.menu-bar')
      let open = false

      toggle?.addEventListener('click', () => {
        open = !open
        mobileMenu?.classList.toggle('hidden', !open)
        header?.classList.toggle('menu-open', open)
        toggle.setAttribute('aria-expanded', String(open))
        bars[0]?.classList.toggle('rotate-45', open)
        bars[0]?.classList.toggle('translate-y-[4px]', open)
        bars[1]?.classList.toggle('-rotate-45', open)
        bars[1]?.classList.toggle('-translate-y-[4px]', open)
      })

      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view')
              observer.unobserve(e.target)
            }
          })
        },
        { threshold: 0.08, rootMargin: '0px 0px -48px 0px' }
      )
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
    </script>


  </body>
</html>
