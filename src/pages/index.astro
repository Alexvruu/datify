---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CALENDLY_URL } from '../../site.config.mjs'
import StackLogos from '../components/StackLogos.astro'
import { UNIVERS, offresParUnivers } from '../data/offres-detail'
import {
  HERO, SYMPTOMES, STACK, EXPERTISES, METHODE, ENGAGEMENTS,
  CAS_PUBLIABLES, PROBLEMES, FAQ, PREUVES, CHIFFRES_MARCHE,
} from '../data/home'

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<BaseLayout
  title="Tracking server-side, GA4 et Meta CAPI"
  description="L'écart entre les ventes déclarées par Meta, Google Ads, GA4 et vos ventes réelles se chiffre. Je le mesure et je le corrige. Appel gratuit."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ═══════════ 1 · HERO ═══════════ -->
  <section class="nuit relative pt-24 pb-24 md:pt-32 md:pb-32 overflow-hidden">

    <div class="container relative z-10">
      <div class="grid xl:grid-cols-[minmax(0,1fr)_320px] gap-16 items-start">
        <div>
          <p class="reveal label mb-7">{HERO.surtitre}</p>

          <h1 class="reveal d1 mb-8" style="font-size:clamp(2.3rem,4.6vw,3.9rem);line-height:1.02;letter-spacing:-0.01em;">
            {/* Les coupes ne s'appliquent qu'a partir de 640px : en dessous, le texte
                coule naturellement, sinon un mot se retrouve seul sur sa ligne. */}
            {HERO.titre.map((ligne, i) => (
              <>
                <span class={i === HERO.ligneAccentuee ? 'text-signal' : ''}>{ligne}</span>
                {i < HERO.titre.length - 1 && (
                  <>
                    {' '}
                    <br class="hidden sm:block" />
                  </>
                )}
              </>
            ))}
          </h1>

          <p class="reveal d2 text-lg md:text-xl text-body max-w-2xl mb-10 leading-relaxed">
            {HERO.sousTitre}
          </p>

          <div class="reveal d3 flex flex-wrap items-center gap-5">
            <a
              href={CALENDLY_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-cta="rdv"
              data-cta-loc="hero"
              class="btn-primary text-base"
            >
              Diagnostic gratuit (30 min)
            </a>
            <p class="text-sm text-muted">
              {HERO.ctaNote[0]}<br class="hidden sm:block" />
              {HERO.ctaNote[1]}
            </p>
          </div>

          <div class="reveal d3 xl:hidden flex items-center gap-3 mt-8">
            <img src="/alexandre.jpg" alt="Alexandre Gire" width="48" height="48" class="w-12 h-12 rounded-full object-cover shrink-0" />
            <div>
              <p class="text-sm font-semibold text-ink leading-tight">Alexandre Gire</p>
              <p class="text-sm text-muted leading-tight">Tracking et data · Lyon, à distance</p>
            </div>
          </div>

          <div class="reveal d4 flex flex-wrap gap-x-10 gap-y-4 mt-14 pt-10 border-t border-line">
            {HERO.chiffres.map(({ v, l }) => (
              <div>
                <div class="text-2xl font-bold text-ink">{v}</div>
                <div class="text-sm text-muted mt-0.5">{l}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Carte identité (écrans larges). Sur les écrans plus petits, la photo apparaît sous le bouton. -->
        <aside class="reveal d3 hidden xl:block bg-mist border border-line rounded-lg p-8">
          <img src="/alexandre.jpg" alt="Alexandre Gire" width="80" height="80" class="w-20 h-20 rounded-full object-cover mb-5" />
          <p class="font-semibold text-ink">Alexandre Gire</p>
          <p class="text-sm text-muted mt-1 mb-5">Analytics engineer · Tracking et data</p>
          <p class="text-sm text-body leading-relaxed">
            Je pose des architectures de mesure en agence : GTM server-side,
            Meta CAPI, GA4, BigQuery. Je travaille seul sur vos comptes, sans sous-traitance.
          </p>
          {/* TODO Alexandre : certifications vérifiables à lister ici (Google Analytics, Google Ads, Meta Blueprint, diplôme). */}
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════ 2 · STACK (logos, Google Cloud en vedette) ═══════════ -->
  <!-- DEUX UNIVERS -->
  <section class="py-24 bg-mist border-b border-line">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <p class="label mb-3">Deux façons de travailler ensemble</p>
        <h2>La mesure d’abord, l’usage ensuite</h2>
        <p class="text-body mt-4">Beaucoup d’entreprises m’appellent pour la première, et restent pour la seconde. Les deux se tiennent : des chiffres justes ne servent à rien s’ils dorment dans un export, et un bel outil bâti sur des données fausses ne fait qu’accélérer les mauvaises décisions.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {UNIVERS.map((u, i) => (
          <div class="bg-white border border-line rounded-lg p-8">
            <p class="font-mono text-sm text-signal">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="text-2xl text-ink mt-3 leading-snug">{u.nom}</h3>
            <p class="text-body mt-3">{u.promesse}</p>
            <ul class="mt-6 space-y-3.5">
              {offresParUnivers(u.cle).map((p) => (
                <li>
                  <a href={`/offres/${p.slug}`} class="block group">
                    <span class="flex items-baseline gap-3">
                      <span class="text-signal shrink-0" aria-hidden="true">→</span>
                      <span class="text-[15px] text-ink font-medium group-hover:text-signal transition-colors">{p.nom}</span>
                    </span>
                    <span class="block pl-7 text-sm text-muted leading-snug">{p.accroche}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <StackLogos />

  <!-- ═══════════ 3 · LE PROBLÈME ═══════════ -->
  <section class="py-28 md:py-32 bg-paper">
    <div class="container">
      <div class="mb-16 max-w-2xl">
        <p class="reveal label mb-4">Le problème</p>
        <h2 class="reveal d1">Trois symptômes,<br />presque toujours les mêmes</h2>
        <p class="reveal d2 text-body mt-6 leading-relaxed">
          Si l'un d'eux vous parle, l'appel de 30 minutes suffira à confirmer d'où il vient.
        </p>
      </div>

      <div class="grid gap-px bg-line border border-line rounded-lg overflow-hidden">
        {SYMPTOMES.map((s, i) => (
          <div class={`reveal d${i + 1} bg-white p-8 md:p-11 grid md:grid-cols-3 gap-8 items-start`}>
            <p class="text-ink font-semibold leading-snug text-lg">{s.probleme}</p>
            <div class="md:col-span-2 grid sm:grid-cols-2 gap-8">
              <div>
                <p class="label mb-2">Cause fréquente</p>
                <p class="text-sm text-body leading-relaxed">{s.cause}</p>
              </div>
              <div>
                <p class="label mb-2">Le correctif</p>
                <p class="text-sm text-body leading-relaxed">{s.geste}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 4 · EXPERTISES ═══════════ -->
  <section class="py-28 md:py-32 bg-mist">
    <div class="container">
      <div class="mb-16 max-w-2xl">
        <p class="reveal label mb-4">Interventions</p>
        <h2 class="reveal d1">Ce que je fais,<br />en détail</h2>
        <p class="reveal d2 text-body mt-6 leading-relaxed">
          Quatre types de mission. La plupart des projets commencent par la première
          et s'arrêtent là où vous décidez.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {EXPERTISES.map((e, i) => (
          <article class={`reveal d${(i % 2) + 1} bg-white rounded-lg border border-line p-9 md:p-10 flex flex-col`}>
            <h3 class="text-xl text-ink mb-2">{e.titre}</h3>
            <p class="text-signal text-sm font-medium mb-5">{e.accroche}</p>

            <p class="text-sm text-muted mb-6 pb-6 border-b border-line">
              <span class="font-semibold text-body">Pour qui : </span>{e.pourQui}
            </p>

            <ul class="space-y-3 mb-7">
              {e.contenu.map((c) => (
                <li class="flex items-start gap-3 text-sm text-body leading-relaxed">
                  <span class="text-signal mt-0.5 shrink-0">✓</span>
                  {c}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-6 border-t border-line">
              <p class="label mb-3">Vous repartez avec</p>
              <div class="flex flex-wrap gap-2">
                {e.livrables.map((l) => (
                  <span class="text-xs bg-mist border border-line text-body px-3 py-1.5 rounded-full">{l}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 4 bis · CE QUE DIT LE MARCHÉ ═══════════ -->
  <section class="py-24 bg-paper border-y border-line">
    <div class="container">
      <div class="max-w-2xl mb-12">
        <p class="label mb-3">Ce que dit le marché</p>
        <h2>Trois faits qui expliquent l’écart</h2>
        <p class="text-body mt-4">Des données publiques, sourcées et datées. Aucune statistique maison, aucun chiffre client.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {CHIFFRES_MARCHE.map((c) => (
          <div class="bg-white border border-line rounded-lg p-7 flex flex-col">
            <p class="font-display text-3xl text-ink leading-none">{c.valeur}</p>
            <p class="text-[15px] text-ink mt-3 leading-snug">{c.libelle}</p>
            <p class="text-[15px] text-body mt-4 flex-1">{c.consequence}</p>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="text-xs text-muted hover:text-ink underline mt-6 pt-4 border-t border-line">{c.source}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 5 · MÉTHODE ═══════════ -->
  <section class="py-28 md:py-32 bg-paper">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div class="max-w-xl">
          <p class="reveal label mb-4">Méthode</p>
          <h2 class="reveal d1">Comment<br />ça se passe</h2>
        </div>
        <p class="reveal d2 text-body max-w-sm md:text-right leading-relaxed">
          Quatre étapes, des délais annoncés, et un point de sortie à chacune.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-px bg-line border border-line rounded-lg overflow-hidden">
        {METHODE.map((m, i) => (
          <div class={`reveal d${i + 1} bg-white p-8 md:p-9`}>
            <span class="text-4xl font-black text-line block mb-6 leading-none select-none">{m.n}</span>
            <h3 class="text-ink mb-1.5 text-lg">{m.titre}</h3>
            <p class="text-xs font-semibold text-signal mb-4">{m.duree}</p>
            <p class="text-sm text-body leading-relaxed">{m.contenu}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 5 bis · PREUVES ANONYMISÉES ═══════════ -->
  <section class="py-28 nuit">
    <div class="container">
      <div class="max-w-2xl mb-14">
        <p class="label mb-3">Déjà vu sur de vrais comptes</p>
        <h2 class="text-white">Six symptômes, six vraies causes</h2>
        <p class="mt-5 leading-relaxed">
          Missions menées en agence, volontairement anonymisées : aucun nom de client, aucun chiffre permettant d’en
          identifier un. Je ne publierai un cas nommé qu’avec l’accord écrit du client concerné.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PREUVES.map((p) => (
          <article class="rounded-lg border border-white/12 bg-white/5 p-7 flex flex-col">
            <p class="font-mono text-xs uppercase tracking-wider text-night-muted mb-2">Symptôme</p>
            <p class="text-white leading-snug">{p.symptome}</p>
            <p class="font-mono text-xs uppercase tracking-wider text-night-muted mt-6 mb-2">Vraie cause</p>
            <p class="text-[15px]">{p.cause}</p>
            <p class="font-mono text-xs uppercase tracking-wider text-night-muted mt-6 mb-2">Correctif</p>
            <p class="text-[15px]">{p.correctif}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 6 · CAS CLIENTS (masqué tant que non rempli) ═══════════ -->
  {CAS_PUBLIABLES.length > 0 && (
    <section class="py-28 md:py-32 nuit">
      <div class="container">
        <div class="mb-16 max-w-2xl">
          <p class="reveal label text-white/30 mb-4">Missions</p>
          <h2 class="reveal d1 text-white">Ce que ça a donné,<br />sur de vrais comptes</h2>
          <p class="reveal d2 text-white/50 mt-6 leading-relaxed">
            Clients anonymisés par obligation de confidentialité. Les chiffres, eux, sont relevés.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {CAS_PUBLIABLES.map((c, i) => (
            <article class={`reveal d${i + 1} bg-white/[0.04] border border-white/10 rounded-lg p-8 flex flex-col`}>
              <p class="text-xs font-semibold text-signal uppercase tracking-widest mb-6">{c.secteur}</p>
              <dl class="space-y-5 flex-1">
                {[
                  ['Symptôme', c.symptome],
                  ['Trouvé', c.trouve],
                  ['Fait', c.fait],
                ].map(([k, v]) => (
                  <div>
                    <dt class="text-[0.6875rem] font-semibold uppercase tracking-widest text-white/30 mb-1.5">{k}</dt>
                    <dd class="text-sm text-white/70 leading-relaxed">{v}</dd>
                  </div>
                ))}
              </dl>
              <div class="mt-7 pt-6 border-t border-white/10">
                <p class="text-[0.6875rem] font-semibold uppercase tracking-widest text-white/30 mb-1.5">Résultat</p>
                <p class="text-white font-medium leading-snug">{c.resultat}</p>
                <p class="text-xs text-white/40 mt-3">{c.duree}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════ 7 · ENGAGEMENTS ═══════════ -->
  <section class="py-28 md:py-32 bg-mist">
    <div class="container">
      <div class="mb-16 max-w-2xl">
        <p class="reveal label mb-4">Engagements</p>
        <h2 class="reveal d1">Ce sur quoi<br />vous pouvez compter</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {ENGAGEMENTS.map((e, i) => (
          <div class={`reveal d${(i % 2) + 1} bg-white rounded-lg border border-line p-9`}>
            <h3 class="text-ink mb-3 text-lg">{e.titre}</h3>
            <p class="text-sm text-body leading-relaxed">{e.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 8 · MATRICE DE PROBLÈMES ═══════════ -->
  <section class="py-28 md:py-32 bg-paper">
    <div class="container">
      <div class="mb-16 max-w-2xl">
        <p class="reveal label mb-4">Périmètre</p>
        <h2 class="reveal d1">Votre problème est<br />probablement là-dedans</h2>
        <p class="reveal d2 text-body mt-6 leading-relaxed">
          La liste de ce que je traite couramment. Si le vôtre n'y est pas, dites-le
          pendant l'appel : je vous dirai franchement si c'est dans mes cordes.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {PROBLEMES.map((p, i) => (
          <div class={`reveal d${(i % 3) + 1} border border-line rounded-lg p-7`}>
            <p class="text-xs font-semibold text-signal uppercase tracking-widest mb-4">{p.cat}</p>
            <ul class="space-y-2.5">
              {p.items.map((it) => (
                <li class="flex items-start gap-2.5 text-sm text-body leading-relaxed">
                  <span class="text-muted mt-1.5 w-1 h-1 rounded-full bg-muted shrink-0"></span>
                  {it}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 9 · FAQ ═══════════ -->
  <section class="py-28 md:py-32 bg-mist">
    <div class="container max-w-3xl">
      <div class="mb-14">
        <p class="reveal label mb-4">Objections</p>
        <h2 class="reveal d1">Les questions<br />qu'on me pose</h2>
      </div>

      <div class="space-y-4">
        {FAQ.map((f, i) => (
          <details class={`reveal d${(i % 3) + 1} group bg-white border border-line rounded-md overflow-hidden`}>
            <summary class="cursor-pointer list-none p-7 flex items-start justify-between gap-6">
              <h3 class="text-ink text-base font-semibold leading-snug">{f.q}</h3>
              <span class="text-signal text-xl shrink-0 leading-none transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <div class="px-7 pb-7 -mt-1">
              <p class="text-sm text-body leading-relaxed">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ 10 · CTA FINAL ═══════════ -->
  <section class="py-28 md:py-32 nuit">
    <div class="container text-center max-w-2xl">
      <p class="reveal label text-white/30 mb-6">Première étape</p>
      <h2 class="reveal d1 text-white mb-7">
        Trente minutes<br />pour savoir où vous en êtes
      </h2>
      <p class="reveal d2 text-white/55 mx-auto mb-11 text-lg leading-relaxed">
        On ouvre votre site ensemble et je vous dis ce que je vois. Vous repartez avec
        au moins un problème identifié, que l'on travaille ensemble ensuite ou non.
      </p>
      <div class="reveal d3 flex flex-col items-center gap-5">
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="rdv"
          data-cta-loc="cta-bas-page"
          class="btn-primary text-base"
        >
          Diagnostic gratuit (30 min)
        </a>
        <p class="text-sm text-white/40">
          Ou écrivez-moi depuis la <a href="/contact" class="text-white/70 underline underline-offset-4 hover:text-white">page contact</a>.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
