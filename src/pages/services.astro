---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CALENDLY_URL } from '../../site.config.mjs'
import { OFFRES } from '../data/offres'
import { STACK } from '../data/home'

const faqs = [
  {
    q: 'Par où commencer ?',
    a: 'Par l’appel de cadrage, gratuit. On regarde votre site ensemble et je vous dis quelle offre correspond à votre situation, ou qu’aucun ne se justifie.',
  },
  {
    q: 'Combien ça coûte ?',
    a: 'L’audit est à 290 €, déduit du setup si vous poursuivez. Le reste est chiffré dans un devis écrit, avec périmètre et délai, après l’appel ou l’audit. Pas de facturation à l’heure qui dérape.',
  },
  {
    q: 'La TVA est-elle en plus ?',
    a: 'Non. Les prix sont nets : TVA non applicable, article 293 B du CGI.',
  },
  {
    q: 'Travaillez-vous à distance ?',
    a: 'Oui, à 100 %. Je suis basé à Lyon et j’interviens partout en France.',
  },
  {
    q: 'Combien de missions menez-vous en parallèle ?',
    a: 'Peu, volontairement. Les délais annoncés sont tenables parce que je ne surcharge pas mon planning. Si je ne peux pas démarrer rapidement, je vous le dis pendant l’appel.',
  },
]
---

<BaseLayout
  title="Offres : audit tracking, server-side et data GCP"
  description="Audit tracking à 290 €, setup server-side (GTM, Meta CAPI, GA4), dashboards BigQuery et suivi mensuel. Périmètre écrit, devis avant tout démarrage."
>

  <!-- HERO -->
  <section class="pt-24 pb-16 bg-paper">
    <div class="container max-w-3xl">
      <span class="text-signal text-sm font-semibold uppercase tracking-widest">Offres</span>
      <h1 class="mt-2 text-ink" style="font-size:clamp(2.4rem,5vw,4rem);line-height:1.05;letter-spacing:-0.035em;">Un périmètre écrit, un prix annoncé avant de commencer</h1>
      <p class="mt-4 text-lg text-body max-w-2xl">
        Du diagnostic gratuit au suivi mensuel : chaque offre a un périmètre, un délai et des livrables clairs.
        Les données et les comptes restent à votre nom.
      </p>
    </div>
  </section>

  <!-- OFFRES -->
  <section class="pb-24 bg-paper">
    <div class="container">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {OFFRES.map((o) => (
          <article
            id={o.cle}
            class={`rounded-lg border p-8 flex flex-col ${o.miseEnAvant ? 'border-signal bg-mist' : 'border-line bg-white'}`}
          >
            <p class="text-xs font-semibold uppercase tracking-widest text-muted">{o.role}</p>
            <h2 class="mt-3 text-2xl text-ink">{o.nom}</h2>
            <p class="mt-4">
              <span class="font-mono text-3xl font-medium text-ink">{o.prix}</span>
              {o.note && <span class="ml-2 text-sm text-body">{o.note}</span>}
            </p>
            <p class="mt-4 text-sm text-body">{o.pourQui}</p>
            <ul class="mt-6 space-y-3 flex-1">
              {o.inclus.map((item) => (
                <li class="flex items-start gap-3 text-sm text-body">
                  <span class="text-signal mt-0.5 shrink-0">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-6 pt-5 border-t border-line text-sm font-medium text-ink">Délai : {o.delai}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 text-xs text-muted">Prix nets. TVA non applicable, article 293 B du CGI.</p>
    </div>
  </section>

  <!-- ENGAGEMENT CONSENTEMENT -->
  <section class="py-16 bg-mist border-y border-line">
    <div class="container max-w-3xl">
      <h2 class="text-ink">Un engagement, dans chaque offre</h2>
      <p class="mt-4 text-body">
        Le server-side ne contourne jamais un refus de cookies. Il récupère les pertes techniques :
        bloqueurs, limitations des navigateurs, pages quittées avant le chargement des balises.
        Chaque intervention est mesurée avant et après : vous voyez la différence, ou vous voyez qu’il n’y en a pas.
      </p>
    </div>
  </section>

  <!-- STACK -->
  <section class="py-24 bg-paper">
    <div class="container">
      <span class="text-signal text-sm font-semibold uppercase tracking-widest">Stack</span>
      <h2 class="mt-2 text-ink">Les outils sur lesquels j’interviens</h2>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {STACK.map((g) => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-muted mb-3">{g.groupe}</p>
            <ul class="space-y-2">
              {g.outils.map((t) => <li class="text-sm text-ink">{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-mist">
    <div class="container max-w-2xl">
      <div class="mb-12">
        <span class="text-signal text-sm font-semibold uppercase tracking-widest">FAQ</span>
        <h2 class="mt-2 text-ink">Questions sur les offres</h2>
      </div>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border border-line bg-white rounded-md p-7">
            <h3 class="text-ink mb-3">{faq.q}</h3>
            <p class="text-sm">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-paper">
    <div class="container">
      <div class="bg-ink rounded-lg p-12 text-center">
        <h2 class="text-white mb-4">Votre tracking perd-il des ventes ?</h2>
        <p class="text-[#B8C4D0] mb-8 max-w-md mx-auto">30 minutes, gratuit, votre site ouvert en direct. Vous repartez avec une réponse.</p>
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="rdv"
          data-cta-loc="forfaits-final"
          class="inline-flex items-center gap-2 bg-signal text-white px-8 py-4 rounded-lg font-medium hover:bg-signal-dark transition-colors"
        >
          Diagnostic gratuit (30 min)
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
