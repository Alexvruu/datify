---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { RESSOURCES, NB_RESSOURCES } from '../../data/ressources'
import { CALENDLY_URL } from '../../../site.config.mjs'

const familles = ['Server-side', 'Régies', 'Plateformes', 'Consentement', 'Data'] as const
---

<BaseLayout
  title="Ressources : guides tracking, server-side et data"
  description="Guides permanents sur le tracking server-side, les conversions, le consentement et la data : à quoi ça sert, quand ça ne sert à rien, comment ça casse, et la checklist de contrôle."
>
  <section class="nuit pt-20 pb-20 md:pt-24">
    <div class="container max-w-3xl">
      <p class="label mb-5">Ressources · {NB_RESSOURCES} guides</p>
      <h1 class="text-white" style="font-size:clamp(2rem,4vw,3.2rem);line-height:1.08;letter-spacing:-0.02em;">
        Ce que j’aurais aimé lire avant de payer un prestataire
      </h1>
      <p class="mt-6 text-lg leading-relaxed">
        Des guides écrits depuis les missions, pas depuis la documentation officielle. Chacun dit à quoi l’outil sert,
        quand il ne sert à rien, comment il casse en vrai, et ce qu’il faut vérifier. Tout est daté : sur ce marché,
        une page non datée ne vaut rien.
      </p>
    </div>
  </section>

  <section class="py-20 bg-paper">
    <div class="container space-y-12">
      {familles.map((f) => {
        const liste = RESSOURCES.filter((r) => r.famille === f)
        return liste.length > 0 && (
          <div>
            <div class="flex items-baseline gap-4 mb-5 pb-4 border-b border-line">
              <h2 class="text-xl text-ink">{f}</h2>
              <span class="font-mono text-sm text-muted">{liste.length} guide{liste.length > 1 ? 's' : ''}</span>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {liste.map((r) => (
                <a href={`/ressources/${r.slug}`} class="block bg-white border border-line rounded-lg p-7 hover:border-signal transition-colors">
                  <h3 class="text-lg text-ink leading-snug">{r.titre}</h3>
                  <p class="text-[15px] text-body mt-3">{r.chapo}</p>
                  <span class="inline-block mt-4 text-sm font-medium text-signal">Lire le guide →</span>
                </a>
              ))}
            </div>
          </div>
        )
      })}
    </div>
  </section>

  <section class="py-20 nuit">
    <div class="container text-center max-w-2xl">
      <h2 class="text-white mb-4">Votre cas n’est pas dans la liste ?</h2>
      <p class="mb-8">30 minutes, votre site ouvert en direct. Vous repartez avec une réponse, pas avec un devis imposé.</p>
      <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-cta="rdv" data-cta-loc="ressources-final" class="btn-primary">Diagnostic gratuit (30 min)</a>
    </div>
  </section>
</BaseLayout>
