---
// Stack, partagée entre l'accueil et la page Offres.
// Présentée comme le trajet de la donnée, de la boutique au tableau de bord.
// Données et règles : src/data/stack.ts
import { ETAPES, NB_OUTILS } from '../data/stack'
import OutilsChips from './OutilsChips.astro'

interface Props { titre?: string }
const { titre = 'Les outils que j’utilise, étape par étape' } = Astro.props
---

<section class="py-24 border-y border-line bg-paper" aria-labelledby="stack-titre">
  <div class="container">
    <div class="max-w-2xl mb-10">
      <p class="label mb-3">Stack · {NB_OUTILS} outils</p>
      <h2 id="stack-titre">{titre}</h2>
      <p class="text-body mt-4">Vos données font un trajet : de votre boutique aux régies publicitaires, puis jusqu’à votre tableau de bord. Voici où j’interviens, et avec quoi.</p>
      <p class="text-body mt-3 text-[15px]">Chaque outil est cliquable : à quoi il sert, ce que j’en fais, et là où il casse en silence. <a href="/ressources/outils" class="text-signal font-medium hover:underline">Voir les {NB_OUTILS} fiches</a>.</p>
    </div>

    <!-- Le trajet en un coup d'œil : chaque étape renvoie à son détail -->
    <ol class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 lg:gap-0 mb-8" aria-label="Les 6 étapes">
      {ETAPES.map((e, i) => (
        <li class="flex items-center">
          <a href={`#stack-${e.num}`} class={`group flex-1 flex items-center gap-2.5 rounded-md border px-3 py-2.5 transition-colors ${e.vedette ? 'border-signal/40 bg-signal-soft' : 'border-line bg-white hover:border-signal/40'}`}>
            <span class="font-mono text-xs text-signal">{e.num}</span>
            <span class="text-sm font-medium text-ink leading-tight">{e.court}</span>
          </a>
          {i < ETAPES.length - 1 && <span class="hidden lg:block px-1.5 text-muted" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>

    <div class="bg-white border border-line rounded-lg overflow-hidden">
      {ETAPES.map((e, i) => (
        <div id={`stack-${e.num}`} class={`scroll-mt-24 grid md:grid-cols-[300px_minmax(0,1fr)] gap-6 md:gap-10 p-6 md:p-10 ${i > 0 ? 'border-t border-line' : ''} ${e.vedette ? 'bg-signal-soft/60' : ''}`}>
          <div class="relative pl-14">
            <span class={`absolute left-0 top-0 w-10 h-10 rounded-full flex items-center justify-center font-mono text-sm ${e.vedette ? 'bg-signal text-white' : 'border-2 border-signal/60 text-signal bg-white'}`}>{e.num}</span>
            {i < ETAPES.length - 1 && <span class="hidden md:block absolute left-[19px] top-12 -bottom-10 w-0.5 bg-signal/15" aria-hidden="true"></span>}
            <h3 class="text-xl md:text-2xl leading-tight">{e.titre}</h3>
            <p class="text-body text-[15px] mt-2 leading-snug">{e.role}</p>
            {e.accroche && <p class="mt-4 text-ink font-semibold leading-snug">{e.accroche}</p>}
          </div>
          <div class="flex flex-col gap-5">
            {e.blocs.map((b) => (
              <div>
                {b.titre && <p class="font-mono text-xs uppercase tracking-wider text-muted mb-2.5">{b.titre}</p>}
                <OutilsChips outils={b.outils} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8">
      <a href="/ressources/outils" class="btn-ghost">Les {NB_OUTILS} fiches outils</a>
    </p>

    <p class="mt-6 text-xs text-muted">Marques citées à titre informatif, sans affiliation ni partenariat.</p>
  </div>
</section>
