---
// Landing de prospection. Une offre, un CTA. Les variantes A/B vivent dans
// src/data/audit.ts ; chaque variante a sa propre URL (/audit, /audit-b) pour que
// le split se fasse par l'email envoyé, sans outil d'A/B testing.
import BaseLayout from '../layouts/BaseLayout.astro'
import { CALENDLY_URL } from '../../site.config.mjs'
import { AUDIT_VARIANTES, AUDIT_COMMUN, type VarianteId } from '../data/audit'

interface Props { variante: VarianteId }
const { variante } = Astro.props
const v = AUDIT_VARIANTES[variante]
const c = AUDIT_COMMUN
---

<BaseLayout title={v.metaTitre} description={c.metaDescription} noindex={true} landing={true}>

  <section class="nuit pt-24 pb-20 md:pt-32">
    <div class="container max-w-3xl">
      <span class="text-signal text-sm font-semibold uppercase tracking-widest">{c.surtitre}</span>
      <h1 class="mt-3 text-ink" style="font-size:clamp(2.4rem,5vw,4rem);line-height:1.05;letter-spacing:-0.035em;">{v.titre}</h1>
      <p class="mt-6 text-lg text-body">{v.sousTitre}</p>
      <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-4">
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="rdv"
          data-cta-loc="audit-hero"
          data-variante={variante}
          class="btn-primary w-fit"
        >{c.cta} →</a>
        <p class="text-sm text-muted">{c.ctaNote}</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-mist border-y border-line">
    <div class="container">
      <div class="grid md:grid-cols-3 gap-6">
        {c.blocs.map((b) => (
          <div class="bg-white rounded-lg border border-line p-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-muted">{b.titre}</p>
            <ul class="mt-5 space-y-3">
              {b.items.map((i) => (
                <li class="flex items-start gap-3 text-sm text-body">
                  <span class="text-signal mt-0.5 shrink-0">✓</span>{i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-paper">
    <div class="container max-w-3xl">
      <h2 class="text-ink">{c.engagementTitre}</h2>
      <p class="mt-4 text-body">{c.engagement}</p>
      <div class="mt-10">
        <a
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="rdv"
          data-cta-loc="audit-final"
          data-variante={variante}
          class="btn-primary w-fit"
        >{c.cta} →</a>
      </div>
      <p class="mt-12 text-xs text-muted max-w-2xl">{c.mentionRgpd}</p>
    </div>
  </section>

</BaseLayout>
