---
// Gabarit des guides publiés sous /ressources. Contenu : src/data/ressources.ts
import BaseLayout from '../layouts/BaseLayout.astro'
import { CALENDLY_URL, SITE_URL } from '../../site.config.mjs'
import { RESSOURCES, type Ressource } from '../data/ressources'

interface Props { ressource: Ressource }
const { ressource: r } = Astro.props
const voisines = RESSOURCES.filter((x) => x.slug !== r.slug && x.famille === r.famille).slice(0, 3)
const url = new URL(`/ressources/${r.slug}`, SITE_URL).toString()
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: r.titre,
  description: r.metaDescription,
  url,
  inLanguage: 'fr',
  author: { '@type': 'Person', name: 'Alexandre Gire' },
  publisher: { '@type': 'Organization', name: 'Datify', url: SITE_URL },
}
const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: r.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout title={r.metaTitre} description={r.metaDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdFaq)} />

  <section class="nuit pt-20 pb-16 md:pt-24">
    <div class="container">
      <nav aria-label="Fil d’Ariane" class="mb-7 font-mono text-xs uppercase tracking-wider">
        <a href="/ressources" class="text-night-muted hover:text-white transition-colors">Ressources</a>
        <span class="text-night-muted mx-2">/</span>
        <span class="text-white">{r.famille}</span>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-white" style="font-size:clamp(2rem,3.8vw,3rem);line-height:1.1;letter-spacing:-0.02em;">{r.titre}</h1>
        <p class="mt-5 text-lg leading-relaxed">{r.chapo}</p>
      </div>
    </div>
  </section>

  <!-- RÉPONSE COURTE -->
  <section class="py-14 bg-signal-soft border-b border-line">
    <div class="container max-w-3xl">
      <p class="label mb-3">La réponse en 30 secondes</p>
      <p class="text-lg text-ink leading-relaxed">{r.reponseCourte}</p>
    </div>
  </section>

  <section class="py-20 bg-paper">
    <div class="container grid lg:grid-cols-[minmax(0,1fr)_300px] gap-12">
      <div class="max-w-3xl">
        <h2 class="mb-6">À quoi ça sert</h2>
        <div class="space-y-4">
          {r.aQuoiCaSert.map((t) => <p class="text-body">{t}</p>)}
        </div>

        <h2 class="mt-16 mb-3">Quand ça ne sert à rien</h2>
        <p class="text-body mb-6">La partie que personne n’écrit, et qui vous évite de payer pour rien.</p>
        <ul class="space-y-4">
          {r.quandCaNeSertPas.map((t) => (
            <li class="flex items-start gap-4 bg-white border border-line rounded-lg p-5">
              <span class="font-mono text-ecart shrink-0" aria-hidden="true">—</span>
              <span class="text-[15px] text-body">{t}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-16 mb-3">Comment ça casse, en vrai</h2>
        <p class="text-body mb-6">Pannes rencontrées en mission, anonymisées : aucun nom de client, aucun chiffre permettant d’en identifier un.</p>
        <div class="space-y-4">
          {r.pannes.map((p) => (
            <div class="bg-white border border-line rounded-lg p-6">
              <p class="text-ink font-semibold leading-snug">{p.probleme}</p>
              <p class="font-mono text-xs uppercase tracking-wider text-muted mt-4 mb-1">Vraie cause</p>
              <p class="text-[15px] text-body">{p.cause}</p>
              <p class="font-mono text-xs uppercase tracking-wider text-muted mt-3 mb-1">Correctif</p>
              <p class="text-[15px] text-body">{p.correctif}</p>
            </div>
          ))}
        </div>

        <h2 class="mt-16 mb-6">La checklist de contrôle</h2>
        <ul class="bg-white border border-line rounded-lg divide-y divide-line">
          {r.checklist.map((c) => (
            <li class="flex items-start gap-3 p-4 text-[15px] text-body">
              <span class="text-signal mt-0.5 shrink-0" aria-hidden="true">✓</span>{c}
            </li>
          ))}
        </ul>

        {r.couts && (
          <>
            <h2 class="mt-16 mb-6">Ce que ça coûte</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-[15px] border border-line rounded-lg bg-white">
                <tbody>
                  {r.couts.map((c) => (
                    <tr class="border-b border-line last:border-0">
                      <td class="p-4 font-medium text-ink whitespace-nowrap">{c.poste}</td>
                      <td class="p-4 text-body">{c.montant}</td>
                      <td class="p-4 text-muted text-sm">{c.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-muted">Montants indicatifs, facturés par leurs éditeurs. À vérifier au moment du devis.</p>
          </>
        )}

        <h2 class="mt-16 mb-6">Questions fréquentes</h2>
        <div class="space-y-4">
          {r.faqs.map((f) => (
            <div class="border border-line bg-white rounded-md p-6">
              <h3 class="text-ink mb-2 text-lg leading-snug">{f.q}</h3>
              <p class="text-[15px]">{f.a}</p>
            </div>
          ))}
        </div>

        {r.sources && (
          <p class="mt-10 text-xs text-muted">
            Sources : {r.sources.map((s, i) => (
              <>
                {i > 0 && <span> · </span>}
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="underline hover:text-ink">{s.label}</a>
              </>
            ))}
          </p>
        )}
        <p class="mt-2 text-xs text-muted">Page vérifiée le {r.verifieLe}. Ce marché bouge : si vous lisez ceci bien plus tard, redemandez-moi.</p>
      </div>

      <aside class="lg:sticky lg:top-24 self-start space-y-6">
        <div class="bg-white border border-line rounded-lg p-6">
          <p class="label mb-3">L’offre liée</p>
          <h3 class="text-lg text-ink leading-snug">{r.offre.nom}</h3>
          <p class="text-[15px] text-body mt-2">{r.offre.phrase}</p>
          <a href={`/offres/${r.offre.slug}`} class="inline-block mt-4 text-sm font-medium text-signal hover:underline">Voir l’offre →</a>
        </div>
        <div class="nuit rounded-lg p-6">
          <p class="text-white font-semibold leading-snug">Un doute sur votre cas ?</p>
          <p class="text-sm mt-2 mb-4">30 minutes, votre site ouvert en direct.</p>
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" data-cta="rdv" data-cta-loc={`ressource-${r.slug}`} class="btn-primary text-sm py-2.5 px-5">Diagnostic gratuit</a>
        </div>
        {voisines.length > 0 && (
          <div class="bg-white border border-line rounded-lg p-6">
            <p class="label mb-3">Dans la même famille</p>
            <ul class="space-y-3">
              {voisines.map((v) => (
                <li><a href={`/ressources/${v.slug}`} class="text-[15px] text-ink hover:text-signal transition-colors leading-snug block">{v.titre}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>
