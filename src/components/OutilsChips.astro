---
// Puces d'outils avec logo, partagées entre la stack et les pages d'offre.
import type { Outil } from '../data/stack'
interface Props { outils: Outil[] }
const { outils } = Astro.props
const initiales = (o: Outil) => {
  const mots = o.name.replace(/[^\p{L}\p{N}\s]/gu, '').split(/\s+/).filter(Boolean)
  return (mots.length > 1 ? mots.map((m) => m[0]).join('') : mots[0]).slice(0, 2).toUpperCase()
}
---
<ul class="flex flex-wrap gap-2.5">
  {outils.map((o) => (
    <li class="inline-flex items-center gap-2.5 rounded-md border border-line bg-paper px-3 py-2 max-w-full">
      {o.path
        ? <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="shrink-0"><path fill={o.hex} d={o.path} /></svg>
        : <span class="w-5 h-5 shrink-0 rounded bg-mist text-muted font-mono text-[9px] flex items-center justify-center" aria-hidden="true">{initiales(o)}</span>}
      <span class="text-[15px] font-medium text-ink leading-tight whitespace-nowrap">{o.name}</span>
      {o.detail && <span class="hidden sm:inline text-[13px] text-muted leading-tight">{o.detail}</span>}
    </li>
  ))}
</ul>
